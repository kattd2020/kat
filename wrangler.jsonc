{
  "name": "plateful",
  "main": "worker/index.js",
  "compatibility_date": "2025-04-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "plateful365.com", "custom_domain": true, "zone_name": "plateful365.com" },
    { "pattern": "www.plateful365.com", "custom_domain": true, "zone_name": "plateful365.com" }
  ]
}
