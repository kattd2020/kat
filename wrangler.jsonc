{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plateful",
  "main": "worker/index.js",
  "compatibility_date": "2026-04-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
