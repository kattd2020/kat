{
  "$schema": "node_modules/wrangler/config-schema.json",
  // plateful365.com (and www.) are bound to the "plateful" Worker —
  // verified via GET /accounts/:id/workers/domains. There is also a
  // "kat" Worker on the account with identical code (legacy/leftover)
  // but it is NOT routed to the custom domain. Deploy to "plateful"
  // to update the live site.
  "name": "plateful",
  "main": "worker/index.js",
  "compatibility_date": "2026-04-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
